# AutoSOC FastAPI Backend Environment Configuration
# Safe defaults for local development. Do not add real secrets here.

# Basic Settings
PROJECT_NAME="AutoSOC Backend API"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
APP_VERSION=0.1.0-dev
API_V1_STR=/api/v1
COMMIT_ID=unknown

# CORS Settings (JSON List of allowed origins)
# Explicitly allows the local Next.js development server
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Note: In future phases, credentials for Postgres, OpenSearch, 
# Redpanda, Redis, MinIO, Keycloak, and Ollama will be configured here.
# None of these values should be exposed to the client application.
